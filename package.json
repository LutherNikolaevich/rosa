{
  "name": "rosa",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "vercel-build": "npm run db:migrate && next build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "if [ -n \"$DATABASE_URL$POSTGRES_URL\" ]; then drizzle-kit migrate; else echo 'no DATABASE_URL, skipping migrations'; fi",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@upstash/ratelimit": "^2.2.1",
    "@upstash/redis": "^1.41.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.9.0",
    "@vercel/global-config": "^1.5.1",
    "@vercel/speed-insights": "^2.1.0",
    "botid": "^1.5.13",
    "detect-gpu": "^5.0.70",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^14.14.0",
    "lz-string": "^1.5.0",
    "nanoid": "^6.0.2",
    "next": "^16.4.6",
    "postprocessing": "^6.39.6",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
